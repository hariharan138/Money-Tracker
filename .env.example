# MongoDB Atlas connection string (Atlas UI -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=expenses
MONGODB_COLLECTION=expenses

# Shared secret the iPhone Shortcut sends as the X-API-Key header.
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SHORTCUT_API_KEY=replace-me

# Optional: more people. "Name:key,Name2:key2" (same key generator).
# The key above belongs to DEFAULT_USER (default "Me").
# EXPENSE_USERS=Wife:another-long-key,Roommate:yet-another-key
# DEFAULT_USER=Hari

# Browser origins allowed to call this API (the deployed dashboard's URL).
# Comma-separated. Leave unset to allow no cross-origin browser calls at all.
# CORS_ORIGINS=https://expenses.example.com

# Environment configuration
# ENVIRONMENT=production  # "production" or "development" (default: development)
# FRONTEND_POLL_INTERVAL_MS=300000  # Frontend polling interval in milliseconds (default: 300000 = 5 minutes)
# ENABLE_CRONJOB_PING=true  # Enable /ping endpoint for cronjob.org wake-ups (default: true)
# CRONJOB_PING_INTERVAL_MINUTES=4  # Interval /ping advertises for an external cron (default: 4)

# Keep-alive: the app pings its own public URL so Render's free tier never
# sees 15 idle minutes. Turn this on for a deployed instance only.
# KEEPALIVE_ENABLED=true
# Leave KEEPALIVE_URL unset on Render: RENDER_EXTERNAL_URL is injected and used.
# Set it only when the public URL differs (custom domain, non-Render host).
# KEEPALIVE_URL=https://your-app.onrender.com
# KEEPALIVE_PATH=/ping              # use /health if ENABLE_CRONJOB_PING=false
# KEEPALIVE_INTERVAL_MINUTES=10     # clamped to 1-14 (Render sleeps at 15)
