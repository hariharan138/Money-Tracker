# MongoDB Atlas connection string (Atlas UI -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=expenses
MONGODB_COLLECTION=expenses

# Shared secret the iPhone Shortcut sends as the X-API-Key header.
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SHORTCUT_API_KEY=replace-me

# Optional: more people. "Name:key,Name2:key2" (same key generator).
# The key above belongs to DEFAULT_USER (default "Me").
# EXPENSE_USERS=Wife:another-long-key,Roommate:yet-another-key
# DEFAULT_USER=Hari

# Environment configuration
# ENVIRONMENT=production  # "production" or "development" (default: development)
# FRONTEND_POLL_INTERVAL_MS=300000  # Frontend polling interval in milliseconds (default: 300000 = 5 minutes)
# ENABLE_CRONJOB_PING=true  # Enable /ping endpoint for cronjob.org wake-ups (default: true)
# CRONJOB_PING_INTERVAL_MINUTES=4  # Recommended cronjob.org ping interval (default: 4 minutes)
